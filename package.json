{
  "name": "twott-bot",
  "version": "0.1.0",
  "description": "Discord bot for The Wolves Of The Trinity guild on SAO Chronicles",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "start": "node src/index.js",
    "deploy:commands": "node src/deploy-commands.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:push": "prisma db push --skip-generate --accept-data-loss",
    "postinstall": "prisma generate"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "discord.js": "^14.16.3",
    "dotenv": "^16.4.5",
    "minecraft-server-util": "^5.4.4",
    "node-cron": "^3.0.3"
  },
  "devDependencies": {
    "prisma": "^5.22.0"
  }
}
