# Discord
DISCORD_TOKEN=your_bot_token_here
CLIENT_ID=your_application_id_here
GUILD_ID=your_discord_server_id_here

# Database (Railway fournit DATABASE_URL automatiquement)
DATABASE_URL=postgresql://user:password@localhost:5432/twott

# Minecraft Server (SAO Chronicles)
MC_SERVER_HOST=play.saochronicles.fr
MC_SERVER_PORT=25565

# Voice channel rename interval (minimum 5, Discord rate-limit)
STATUS_UPDATE_INTERVAL_MINUTES=5

# Ticket system defaults (each can also be set via /ticket config)
TICKET_CATEGORY_ID=1498662129992208474
TICKET_STAFF_ROLE_ID=
TICKET_LOG_CHANNEL_ID=
TICKET_ACCEPT_ROLE_ID=
# Rôle additionnel attribué en plus à l'acceptation (ex: rôle "Membre de la guilde")
TICKET_ACCEPT_ROLE_ID_2=1418179781756719220

# Role attribué quand on accepte le règlement
VISITOR_ROLE_ID=1418179781408854091

# Salon par défaut où poster le règlement (/reglement post)
REGLEMENT_CHANNEL_ID=1418179782553899131

# URL de l'image affichée en bas de l'embed règlement (laisser vide = pas d'image)
REGLEMENT_BANNER_URL=

# Salon où sont postés tous les logs serveur
LOG_CHANNEL_ID=1418179783405342794

# Salon où sont postés les messages de bienvenue (laisser vide = désactivé)
WELCOME_CHANNEL_ID=

# URL de la bannière affichée dans l'embed de bienvenue (laisser vide = pas d'image)
WELCOME_BANNER_URL=
